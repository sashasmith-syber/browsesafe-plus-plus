{
  "manifest_version": 3,
  "name": "Sentinel Operator Bridge",
  "version": "1.0.0",
  "description": "Chromium MV3 extension implementing strict content sanitization and operator-only command gate for agentic browsing",
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html",
    "allowed_paths": ["*://*/*"]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  },
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
